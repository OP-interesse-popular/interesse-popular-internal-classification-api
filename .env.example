APP_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,::1
DB_CONNECTION_STRING=host=localhost user=opip password=opip dbname=opip_internal_classification port=5433 sslmode=disable
AUTO_MIGRATE=true
REDIS_URL=redis://localhost:6379/0
EXTERNAL_HTTP_TIMEOUT=30s
PARLIAMENTARIANS_CACHE_CHECK_INTERVAL=1m
PARLIAMENTARIANS_REFRESH_INTERVAL=1h
PARLIAMENTARIANS_CACHE_TTL=8h
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
TSE_ELECTED_CANDIDATES_URL=https://cdn.tse.jus.br/estatistica/sead/odsele/consulta_cand/consulta_cand_2026.zip
INTERNAL_API_KEY=replace-with-a-long-random-secret
INTERNAL_READ_API_KEY=replace-with-a-different-read-only-secret
